VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here

# VITE_SUPABASE_ANON_KEY also works (legacy name)

# --- Vercel: add the same names in Project → Settings → Environment Variables ---
# Never commit real keys. Redeploy after changing env vars (Vite bakes them at build time).

# Optional browser-restricted Google Maps / Places key (public).
# Enable "Maps JavaScript API" + "Places API" in Google Cloud Console.
# Restrict the key to your Vercel domain + localhost for production safety.
# VITE_MAP_PROVIDER_KEY=
